---
import type { Lang } from "../i18n/ui.ts";
import type { Figure } from "../content/projects.ts";
import Gantt from "./figures/Gantt.astro";
import Coverage from "./figures/Coverage.astro";
import OzoneDiagram from "./figures/OzoneDiagram.astro";
import OzonePhotos from "./figures/OzonePhotos.astro";
import OzoneResults from "./figures/OzoneResults.astro";
import DafterShots from "./figures/DafterShots.astro";
import DafterStack from "./figures/DafterStack.astro";

interface Props {
  name: Figure;
  lang: Lang;
  compact?: boolean;
}
const { name, lang, compact = false } = Astro.props;
---

{name === "gantt" && <Gantt lang={lang} compact={compact} />}
{name === "coverage" && <Coverage lang={lang} compact={compact} />}
{name === "ozone-diagram" && <OzoneDiagram lang={lang} compact={compact} />}
{name === "ozone-photos" && <OzonePhotos lang={lang} />}
{name === "ozone-results" && <OzoneResults lang={lang} />}
{name === "dafter-stack" && <DafterStack lang={lang} compact={compact} />}
{name === "dafter-core-shots" && <DafterShots lang={lang} set="core" />}
{name === "dafter-cod-shots" && <DafterShots lang={lang} set="cod" />}
