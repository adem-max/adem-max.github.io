---
import { getRelativeLocaleUrl } from "astro:i18n";
import { copy, CV_HREF, EMAIL, LINKEDIN, type Lang } from "../i18n/ui.ts";
import { projects } from "../content/projects.ts";
import Figure from "./Figure.astro";
import Gantt from "./figures/Gantt.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const work = projects[lang];
const url = (slug: string) => getRelativeLocaleUrl(lang, `work/${slug}`);

// Simple line icons for the three tracks.
const ICONS = {
  field: "M13 2 4 14h7l-1 8 9-12h-7l1-8Z",
  software: "M8 7 3 12l5 5M16 7l5 5-5 5M14 4l-4 16",
  planning: "M4 5h16M4 5v15h16V5M4 10h16M9 10v10M15 10v10",
};
---

<section class="hero wrap" aria-labelledby="hero-title">
  <p class="eyebrow">{t.hero.eyebrow}</p>
  <h1 id="hero-title">{t.hero.title}</h1>
  <p class="lede">{t.hero.lede}</p>
  <div class="actions">
    <a class="btn primary" href={CV_HREF} download>{t.hero.cv}</a>
    <a class="btn" href="#hire">{t.hero.hire}</a>
    <a class="btn quiet" href={LINKEDIN} rel="me noopener">LinkedIn</a>
  </div>

  <!-- The page's one showpiece: the demo plant's schedule, in the frame the case studies use. -->
  <figure class="window">
    <figcaption class="window-bar">
      <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="window-title">{t.hero.chart}</span>
      <a class="window-link" href={url("scheduler")}>{t.hero.chartLink} <span aria-hidden="true">→</span></a>
    </figcaption>
    <div class="window-body">
      <div class="chart-wide"><Gantt lang={lang} hero /></div>
      <div class="chart-narrow"><Gantt lang={lang} hero compact /></div>
    </div>
  </figure>

  <dl class="proof">
    {
      t.stats.map(([big, small]) => (
        <div>
          <dt>{big}</dt>
          <dd>{small}</dd>
        </div>
      ))
    }
  </dl>
</section>

<section id="work" class="section" aria-labelledby="work-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="work-title">{t.work.heading}</h2>
    </div>
    <div class="cards">
      {
        work.map((p) => (
          <a class="card-link" href={url(p.slug)}>
            <article class="pcard">
              <div class:list={["cover", { split: !!(p.cover && p.coverFigure), photo: !!p.cover && !p.coverFigure, portrait: p.coverFigure === "ozone-diagram" }]}>
                {p.coverFigure && (
                  <div class="cover-figure">
                    <Figure name={p.coverFigure} lang={lang} compact />
                  </div>
                )}
                {p.cover && <img src={p.cover.src} alt={p.cover.alt} loading="lazy" />}
              </div>
              <div class="pbody">
                <p class="tags">
                  {p.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </p>
                <h3>{p.title}</h3>
                <p>{p.summary}</p>
                <p class="foot">
                  <span class="status">{p.status}</span>
                  <span class="read">{t.work.read} <span class="arrow" aria-hidden="true">→</span></span>
                </p>
              </div>
            </article>
          </a>
        ))
      }
    </div>
    <p class="note">{t.work.note}</p>
  </div>
</section>

<section id="experience" class="section alt" aria-labelledby="exp-title">
  <div class="wrap split">
    <div class="split-head">
      <h2 id="exp-title">{t.experience.heading}</h2>
      <a class="btn" href={CV_HREF} download>{t.hero.cv}</a>
    </div>
    <div>
      <ol class="timeline">
        {
          t.experience.items.map((job) => (
            <li>
              <span class:list={["when", { current: job.current }]}>{job.when}</span>
              <div>
                <h3>{job.role}</h3>
                <p class="where">{job.where}</p>
                <p>{job.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <h3 class="sub">{t.experience.educationHeading}</h3>
      <ol class="timeline">
        {
          t.experience.education.map((job) => (
            <li>
              <span class="when">{job.when}</span>
              <div>
                <h3>{job.role}</h3>
                <p class="where">{job.where}</p>
                <p>{job.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<section id="tracks" class="section" aria-labelledby="tracks-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="tracks-title">{t.tracks.heading}</h2>
    </div>
    <div class="tracks">
      {
        t.tracks.items.map((track) => (
          <article class="track">
            <svg class="icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
              <path d={ICONS[track.id]} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <h3>{track.title}</h3>
            <p>{track.body}</p>
            <p class="links">
              {track.links.map((l) => (
                <a href={url(l.slug)}>{l.label} <span aria-hidden="true">→</span></a>
              ))}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section id="hire" class="section alt" aria-labelledby="hire-title">
  <div class="wrap split roomy">
    <div class="split-head">
      <h2 id="hire-title">{t.hire.heading}</h2>
      <p>{t.hire.lede}</p>
      <a class="btn primary" href={`mailto:${EMAIL}`}>{t.hire.cta}</a>
    </div>
    <dl class="services">
      {
        t.hire.items.map(([title, body]) => (
          <div class="service">
            <dt>{title}</dt>
            <dd>{body}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  /* Hero: headline across the page, then the schedule as the one showpiece. */
  .hero {
    padding-block: clamp(40px, 7vw, 84px) clamp(48px, 6vw, 72px);
  }
  .hero h1 {
    font-size: clamp(34px, 5vw, 56px);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.03em;
    margin-top: 14px;
  }
  .lede {
    font-size: clamp(17px, 1.6vw, 19px);
    color: var(--muted);
    max-width: 64ch;
    margin: 20px 0 28px;
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .window {
    margin: clamp(36px, 5vw, 56px) 0 0;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 14px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .window-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 11px 18px;
    background: var(--bg-alt);
    border-bottom: 1px solid var(--rule);
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
  }
  .lights {
    display: flex;
    gap: 6px;
  }
  .lights i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--muted) 30%, transparent);
  }
  .window-link {
    margin-left: auto;
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .window-link:hover {
    color: var(--accent-text);
  }
  .window-body {
    padding: 10px 22px 20px;
  }
  .chart-narrow {
    display: none;
  }

  .proof {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: clamp(32px, 4vw, 44px) 0 0;
  }
  .proof > div {
    padding: 2px 24px;
    border-left: 1px solid var(--rule);
  }
  .proof > div:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .proof dt {
    font-size: 22px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .proof dd {
    margin: 6px 0 0;
    font-size: 15px;
    line-height: 1.45;
    color: var(--muted);
  }

  /* Projects */
  .hero + .section {
    padding-top: 0;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .card-link {
    text-decoration: none;
    color: inherit;
    display: block;
    border-radius: 14px;
  }
  .pcard {
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.18s, box-shadow 0.18s, border-color 0.18s;
  }
  .card-link:hover .pcard {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: color-mix(in srgb, var(--ink) 25%, var(--rule));
  }
  .arrow {
    display: inline-block;
    transition: transform 0.18s;
  }
  .card-link:hover .arrow {
    transform: translateX(3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .pcard,
    .arrow {
      transition: none;
    }
    .card-link:hover .pcard,
    .card-link:hover .arrow {
      transform: none;
    }
  }
  .cover {
    background: var(--bg-alt);
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    padding: 22px 26px;
    overflow: hidden;
    border-bottom: 1px solid var(--rule);
  }
  .cover-figure {
    width: 100%;
    min-height: 0;
  }
  .cover.portrait .cover-figure {
    height: 100%;
    display: grid;
    place-items: center;
  }
  .cover.portrait .cover-figure > :global(*) {
    height: 100%;
  }
  .cover.portrait :global(svg) {
    height: 100%;
    width: auto;
    margin-inline: auto;
  }
  .cover.portrait {
    padding: 14px;
  }
  /* Drawing and photo side by side: how it works, and the unit as built. */
  .cover.split {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    place-items: stretch;
    padding: 0;
  }
  .cover.split .cover-figure {
    padding: 14px;
  }
  .cover.split img,
  .cover.photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }
  .cover.photo {
    padding: 0;
  }
  .pbody {
    padding: 22px 26px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .pbody h3 {
    font-size: 22px;
  }
  .pbody p {
    margin: 0;
  }
  .tags {
    display: flex;
    gap: 8px;
  }
  .foot {
    margin-top: auto !important;
    padding-top: 10px;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 14px;
  }
  .status {
    color: var(--muted);
    font-weight: 500;
  }
  .read {
    color: var(--accent-text);
    font-weight: 600;
  }
  .note {
    color: var(--muted);
    font-size: 14px;
    margin: 20px 0 0;
  }

  /* Two-column sections: the heading stays in view while the list scrolls. */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 280px) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }
  .split.roomy {
    grid-template-columns: minmax(0, 420px) minmax(0, 1fr);
  }
  .split-head {
    position: sticky;
    top: 96px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }
  .split-head h2 {
    font-size: clamp(26px, 3.2vw, 34px);
    font-weight: 700;
  }
  .split-head p {
    margin: 0;
    color: var(--muted);
  }
  .split-head .btn {
    margin-top: 8px;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    gap: 24px;
    padding: 20px 0;
    border-bottom: 1px solid var(--rule);
  }
  .timeline li:first-child {
    padding-top: 0;
  }
  .timeline li:last-child {
    border-bottom: 0;
  }
  .when {
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
    padding-top: 3px;
    font-variant-numeric: tabular-nums;
  }
  /* Roles still running are the only ones marked. */
  .when.current {
    color: var(--accent-text);
  }
  .timeline h3 {
    font-size: 18px;
  }
  .timeline p {
    margin: 4px 0 0;
    max-width: var(--measure);
  }
  .where {
    color: var(--muted);
    font-size: 15px;
  }
  .sub {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--muted);
    margin: 12px 0 20px;
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }

  /* Three tracks, as plain columns */
  .tracks {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .track {
    display: flex;
    flex-direction: column;
    padding: 4px 32px;
    border-left: 1px solid var(--rule);
  }
  .track:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .track:last-child {
    padding-right: 0;
  }
  .icon {
    color: var(--accent-text);
    margin-bottom: 14px;
  }
  .track h3 {
    font-size: 20px;
    margin-bottom: 8px;
  }
  .track p {
    margin: 0 0 16px;
    color: var(--muted);
    font-size: 16px;
  }
  .links {
    margin: auto 0 0 !important;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-weight: 600;
    font-size: 15px;
  }
  .links a {
    color: var(--ink);
  }
  .links a:hover {
    color: var(--accent-text);
  }

  /* Services */
  .services {
    margin: 0;
    border-top: 3px solid var(--accent);
  }
  .service {
    display: grid;
    grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
    gap: 4px 24px;
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
  }
  .service dt {
    font-weight: 600;
    color: var(--ink);
  }
  .service dd {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 960px) {
    .split,
    .split.roomy {
      grid-template-columns: 1fr;
    }
    .split-head {
      position: static;
    }
    /* Stacked, the services come before the button that asks about them. */
    .split.roomy {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
    }
    .split.roomy .split-head {
      display: contents;
    }
    .split.roomy .services {
      margin-top: 14px;
    }
    .split.roomy .btn {
      order: 1;
      align-self: flex-start;
      margin-top: 14px;
    }
    .tracks {
      grid-template-columns: 1fr;
    }
    .track,
    .track:first-child,
    .track:last-child {
      padding: 24px 0;
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
    .track:first-child {
      padding-top: 0;
      border-top: 0;
    }
    .track:last-child {
      padding-bottom: 0;
    }
    .proof {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 28px;
    }
    .proof > div:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
  }
  @media (max-width: 680px) {
    .cards {
      grid-template-columns: 1fr;
    }
    .timeline li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .service {
      grid-template-columns: 1fr;
    }
    .chart-wide {
      display: none;
    }
    .chart-narrow {
      display: block;
    }
    .window-body {
      padding: 14px;
    }
    .window-bar {
      padding-inline: 14px;
    }
    .window-title {
      display: none;
    }
    .proof > div {
      padding-right: 0;
      padding-left: 16px;
    }
  }
</style>
