---
import { getRelativeLocaleUrl } from "astro:i18n";
import { copy, CV_HREF, EMAIL, LINKEDIN, type Lang } from "../i18n/ui.ts";
import { projects } from "../content/projects.ts";
import Figure from "./Figure.astro";
import Gantt from "./figures/Gantt.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const work = projects[lang];
const url = (slug: string) => getRelativeLocaleUrl(lang, `work/${slug}`);

// Simple line icons for the three tracks.
const ICONS = {
  field: "M13 2 4 14h7l-1 8 9-12h-7l1-8Z",
  software: "M8 7 3 12l5 5M16 7l5 5-5 5M14 4l-4 16",
  planning: "M4 5h16M4 5v15h16V5M4 10h16M9 10v10M15 10v10",
};
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-text">
    <p class="eyebrow">{t.hero.eyebrow}</p>
    <h1 id="hero-title">{t.hero.title}</h1>
    <p class="lede">{t.hero.lede}</p>
    <div class="actions">
      <a class="btn primary" href={CV_HREF} download>{t.hero.cv}</a>
      <a class="btn" href="#hire">{t.hero.hire}</a>
      <a class="btn ghost" href={LINKEDIN} rel="me noopener">LinkedIn</a>
    </div>
  </div>
  <div class="hero-visual" aria-hidden="true">
    <div class="card big">
      <p class="card-title"><span class="dot"></span>{lang === "en" ? "Demo plant · five-day schedule" : "Usine de démonstration · planning sur cinq jours"}</p>
      <Gantt lang={lang} compact />
    </div>
    <div class="card photo">
      <img src="/img/ozone/unit-corridor.jpg" alt="" width="857" height="1100" />
    </div>
  </div>
</section>

<section class="wrap stats" aria-label={lang === "en" ? "Key facts" : "En bref"}>
  {
    t.stats.map(([big, small]) => (
      <div>
        <p class="big">{big}</p>
        <p class="small">{small}</p>
      </div>
    ))
  }
</section>

<section id="tracks" class="section alt" aria-labelledby="tracks-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{t.tracks.eyebrow}</p>
      <h2 id="tracks-title">{t.tracks.heading}</h2>
    </div>
    <div class="tracks">
      {
        t.tracks.items.map((track) => (
          <article class="track">
            <span class="icon">
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <path d={ICONS[track.id]} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <h3>{track.title}</h3>
            <p>{track.body}</p>
            <p class="links">
              {track.links.map((l) => (
                <a href={url(l.slug)}>{l.label} →</a>
              ))}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section id="work" class="section" aria-labelledby="work-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{t.work.eyebrow}</p>
      <h2 id="work-title">{t.work.heading}</h2>
    </div>
    <div class="cards">
      {
        work.map((p) => (
          <a class="card-link" href={url(p.slug)}>
            <article class="pcard">
              <div class:list={["cover", { photo: !!p.cover }]}>
                {p.cover ? (
                  <img src={p.cover.src} alt={p.cover.alt} loading="lazy" />
                ) : (
                  p.coverFigure && <Figure name={p.coverFigure} lang={lang} compact />
                )}
              </div>
              <div class="pbody">
                <p class="tags">
                  {p.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </p>
                <h3>{p.title}</h3>
                <p>{p.summary}</p>
                <p class="foot">
                  <span class="status">{p.status}</span>
                  <span class="read">{t.work.read} →</span>
                </p>
              </div>
            </article>
          </a>
        ))
      }
    </div>
    <p class="note">{t.work.note}</p>
  </div>
</section>

<section id="experience" class="section alt" aria-labelledby="exp-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{t.experience.eyebrow}</p>
      <h2 id="exp-title">{t.experience.heading}</h2>
    </div>
    <ol class="timeline">
      {
        t.experience.items.map((job) => (
          <li>
            <span class="when">{job.when}</span>
            <div>
              <h3>{job.role}</h3>
              <p class="where">{job.where}</p>
              <p>{job.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section id="hire" class="section" aria-labelledby="hire-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{t.hire.eyebrow}</p>
      <h2 id="hire-title">{t.hire.heading}</h2>
      <p>{t.hire.lede}</p>
    </div>
    <div class="services">
      {
        t.hire.items.map(([title, body]) => (
          <div class="service">
            <h3>{title}</h3>
            <p>{body}</p>
          </div>
        ))
      }
    </div>
    <p class="hire-cta"><a class="btn primary" href={`mailto:${EMAIL}`}>{t.hire.cta}</a></p>
  </div>
</section>

<section id="contact" class="band" aria-labelledby="contact-title">
  <div class="wrap band-inner">
    <div>
      <h2 id="contact-title">{t.contact.heading}</h2>
      <p>{t.contact.lede}</p>
    </div>
    <div class="band-actions">
      <a class="btn primary" href={`mailto:${EMAIL}`}>{t.contact.email}</a>
      <a class="btn on-band" href={LINKEDIN} rel="me noopener">LinkedIn</a>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    padding-block: clamp(48px, 8vw, 104px) clamp(40px, 6vw, 72px);
  }
  .hero h1 {
    font-size: clamp(36px, 5.2vw, 60px);
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-top: 16px;
  }
  .lede {
    font-size: clamp(17px, 1.6vw, 20px);
    color: var(--muted);
    max-width: 52ch;
    margin: 22px 0 32px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .btn.ghost {
    border-color: var(--rule);
  }
  .hero-visual {
    position: relative;
    padding: 0 0 72px 0;
  }
  .card.big {
    width: 88%;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 14px;
    box-shadow: var(--shadow);
  }
  .card.big {
    padding: 22px 20px;
  }
  .card-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 14px;
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
  .card.photo {
    position: absolute;
    width: 36%;
    right: -8px;
    bottom: 0;
    padding: 6px;
    overflow: hidden;
  }
  .card.photo img {
    border-radius: 9px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    width: 100%;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--rule);
    padding-block: 28px 56px;
    gap: 24px;
  }
  .stats p {
    margin: 0;
  }
  .big {
    font-size: 30px;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
  }
  .big::after {
    content: "";
    display: block;
    width: 28px;
    height: 3px;
    background: var(--accent);
    margin-top: 6px;
    border-radius: 2px;
  }
  .small {
    color: var(--muted);
    font-size: 15px;
    margin-top: 8px !important;
    line-height: 1.45;
  }

  .tracks {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .track {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 14px;
    padding: 28px;
    display: flex;
    flex-direction: column;
  }
  .icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent-text);
    margin-bottom: 18px;
  }
  .track h3 {
    font-size: 21px;
    margin-bottom: 10px;
  }
  .track p {
    margin: 0 0 16px;
    color: var(--muted);
  }
  .links {
    margin-top: auto !important;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-weight: 600;
    font-size: 15px;
  }
  .links a {
    color: var(--ink);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .pcard {
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.18s, box-shadow 0.18s, border-color 0.18s;
  }
  .card-link:hover .pcard {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: color-mix(in srgb, var(--ink) 25%, var(--rule));
  }
  @media (prefers-reduced-motion: reduce) {
    .pcard {
      transition: none;
    }
    .card-link:hover .pcard {
      transform: none;
    }
  }
  .cover {
    background: var(--bg-alt);
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    padding: 22px 26px;
    overflow: hidden;
    border-bottom: 1px solid var(--rule);
  }
  .cover > :global(*) {
    width: 100%;
  }
  .cover.photo {
    padding: 0;
  }
  .cover.photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }
  .pbody {
    padding: 22px 26px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .pbody h3 {
    font-size: 22px;
  }
  .pbody p {
    margin: 0;
  }
  .tags {
    display: flex;
    gap: 8px;
  }
  .foot {
    margin-top: auto !important;
    padding-top: 10px;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 14px;
  }
  .status {
    color: var(--muted);
    font-weight: 500;
  }
  .read {
    color: var(--accent-text);
    font-weight: 600;
  }
  .note {
    color: var(--muted);
    font-size: 14px;
    margin-top: 20px;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 880px;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 28px;
    padding: 22px 0;
    border-bottom: 1px solid var(--rule);
  }
  .timeline li:first-child {
    padding-top: 0;
  }
  .when {
    font-size: 15px;
    font-weight: 600;
    color: var(--accent-text);
    padding-top: 2px;
    font-variant-numeric: tabular-nums;
  }
  .timeline h3 {
    font-size: 18px;
  }
  .timeline p {
    margin: 4px 0 0;
    max-width: var(--measure);
  }
  .where {
    color: var(--muted);
    font-size: 15px;
  }

  .services {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .service {
    border-top: 3px solid var(--accent);
    padding-top: 16px;
  }
  .service h3 {
    font-size: 17px;
  }
  .service p {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 15px;
  }
  .hire-cta {
    margin: 32px 0 0;
  }

  .band {
    background: var(--band);
    color: var(--on-band);
    padding-block: clamp(48px, 7vw, 80px);
  }
  .band-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .band h2 {
    color: var(--on-band);
    font-size: clamp(28px, 3.6vw, 40px);
  }
  .band p {
    margin: 8px 0 0;
    opacity: 0.85;
  }
  .band-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .btn.on-band {
    border-color: color-mix(in srgb, var(--on-band) 45%, transparent);
    color: var(--on-band);
  }
  .btn.on-band:hover {
    background: var(--on-band);
    color: var(--band);
  }

  @media (max-width: 960px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero-visual {
      max-width: 560px;
    }
    .services {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tracks {
      grid-template-columns: 1fr;
    }
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 680px) {
    .cards {
      grid-template-columns: 1fr;
    }
    .timeline li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .services {
      grid-template-columns: 1fr;
    }
    .card.photo {
      right: 0;
    }
  }
</style>
