---
// Five days of the demo plant's schedule on eight work units, drawn at build time.
import type { Lang } from "../../i18n/ui.ts";
import { demoPlant, schedule } from "../../lib/schedule.ts";

interface Props {
  lang: Lang;
  compact?: boolean;
}
const { lang, compact = false } = Astro.props;

const UNITS = ["EQ-01", "EQ-04", "EQ-05", "EQ-06", "EQ-08", "EQ-09", "EQ-12", "EQ-15"];
const FR_NAMES: Record<string, string> = {
  "EQ-01": "Tréfileuse de fil machine",
  "EQ-04": "Toronneuse tubulaire 19 fils",
  "EQ-05": "Toronneuse rigide 61 fils",
  "EQ-06": "Câbleuse en faisceau 1",
  "EQ-08": "Ligne d'extrusion 60 mm",
  "EQ-09": "Ligne d'extrusion 90 mm",
  "EQ-12": "Assembleuse (drum twister)",
  "EQ-15": "Ligne de gainage 120 mm",
};

const plant = demoPlant();
const HOURS = 120;
const bars = schedule().filter((b) => UNITS.includes(b.equipment_id) && b.start < HOURS);
const units = UNITS.map((id) => plant.equipment.find((e) => e.equipment_id === id)!);

const left = compact ? 0 : 200;
const width = compact ? 480 : 960;
const chartW = width - left - 8;
const rowH = compact ? 34 : 32;
const barH = compact ? 20 : 18;
const top = compact ? 6 : 34;
const height = top + units.length * rowH + 8;
const x = (h: number) => left + (Math.min(Math.max(h, 0), HOURS) / HOURS) * chartW;

const start = new Date(`${plant.meta.start}T00:00:00Z`);
const days = Array.from({ length: HOURS / 24 }, (_, i) => {
  const d = new Date(start);
  d.setUTCDate(d.getUTCDate() + i);
  return d.toLocaleDateString(lang === "en" ? "en-GB" : "fr-FR", { weekday: "short", day: "numeric", timeZone: "UTC" });
});
const t =
  lang === "en"
    ? { title: "Five-day schedule on the demo plant", onTime: "On time", late: "Ends after its due date", held: "Held" }
    : { title: "Planning sur cinq jours de l'usine de démonstration", onTime: "Dans les délais", late: "Finit après sa date due", held: "Bloqué" };
---

<figure class:list={["gantt", { compact }]}>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={t.title}>
    <defs>
      <pattern id={compact ? "hatch-c" : "hatch"} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="6" height="6" class="held-bg"></rect>
        <line x1="0" y1="0" x2="0" y2="6" class="held-line" stroke-width="3"></line>
      </pattern>
    </defs>
    {
      days.map((label, i) => (
        <g>
          <line x1={x(i * 24)} x2={x(i * 24)} y1={top - (compact ? 4 : 10)} y2={height - 6} class="grid" />
          {!compact && (
            <text x={x(i * 24) + 6} y={top - 14} class="day">
              {label}
            </text>
          )}
        </g>
      ))
    }
    {
      units.map((u, i) => (
        <g>
          {!compact && (
            <text x={0} y={top + i * rowH + rowH / 2 + 5} class="unit">
              {lang === "en" ? u.name : FR_NAMES[u.equipment_id] ?? u.name}
            </text>
          )}
          <line x1={left} x2={width - 8} y1={top + (i + 1) * rowH} y2={top + (i + 1) * rowH} class="row" />
        </g>
      ))
    }
    {
      bars.map((b) => {
        const row = UNITS.indexOf(b.equipment_id);
        const x0 = x(b.start);
        const w = Math.max(x(b.end) - x0 - 1.5, 2);
        return (
          <rect
            x={x0}
            y={top + row * rowH + (rowH - barH) / 2}
            width={w}
            height={barH}
            rx="3"
            class:list={["bar", { late: b.late }]}
            fill={b.held ? `url(#${compact ? "hatch-c" : "hatch"})` : undefined}
          >
            <title>{b.label}</title>
          </rect>
        );
      })
    }
  </svg>
  {
    !compact && (
      <figcaption>
        <span class="key">
          <i class="sw on" />
          {t.onTime}
        </span>
        <span class="key">
          <i class="sw late" />
          {t.late}
        </span>
        <span class="key">
          <i class="sw held" />
          {t.held}
        </span>
      </figcaption>
    )
  }
</figure>

<style>
  .gantt {
    margin: 0;
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
    font-family: var(--f-body);
  }
  .grid {
    stroke: var(--rule);
    stroke-width: 1;
  }
  .row {
    stroke: var(--rule);
    stroke-width: 0.6;
    stroke-dasharray: 2 3;
  }
  .day {
    font-size: 13px;
    fill: var(--muted);
    font-weight: 500;
  }
  .unit {
    font-size: 13px;
    fill: var(--text);
  }
  .bar {
    fill: var(--ink);
  }
  .bar.late {
    fill: var(--accent);
  }
  .held-bg {
    fill: var(--bg-alt);
  }
  .held-line {
    stroke: var(--muted);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-top: 12px;
    font-size: 14px;
    color: var(--muted);
  }
  .key {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .sw {
    width: 14px;
    height: 10px;
    border-radius: 2px;
    display: inline-block;
  }
  .sw.on {
    background: var(--ink);
  }
  .sw.late {
    background: var(--accent);
  }
  .sw.held {
    background: repeating-linear-gradient(45deg, var(--muted) 0 2px, var(--bg-alt) 2px 5px);
  }
  @media (max-width: 640px) {
    .gantt:not(.compact) {
      overflow-x: auto;
    }
    .gantt:not(.compact) svg {
      min-width: 640px;
    }
  }
</style>
