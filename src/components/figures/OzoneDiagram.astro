---
// How the ozone hand-wash works, as a simplified cutaway. It shows the principle only, not the
// real internal layout or the control board.
import type { Lang } from "../../i18n/ui.ts";

interface Props {
  lang: Lang;
  compact?: boolean;
}
const { lang, compact = false } = Astro.props;
const en = lang === "en";
const id = compact ? "oz-c" : "oz";

const L = en
  ? {
      title: "How the ozone hand-wash works",
      air: "Air",
      water: "Tap water",
      items: [
        ["Air pump", "Draws in ambient air"],
        ["Cold-plasma generator", "Turns O₂ into O₃"],
        ["Control and gas safety", "Runs the sequence, shuts down on a leak"],
        ["Venturi injector", "Dissolves the ozone into the flow"],
        ["Touchless tap", "Infrared sensor starts and stops it"],
        ["High-voltage supply", "Drives the plasma, in an earthed case"],
      ],
    }
  : {
      title: "Fonctionnement du lave-mains à l'ozone",
      air: "Air",
      water: "Eau du réseau",
      items: [
        ["Pompe à air", "Aspire l'air ambiant"],
        ["Générateur à plasma froid", "Transforme O₂ en O₃"],
        ["Commande et sécurité gaz", "Pilote la séquence, coupe en cas de fuite"],
        ["Injecteur Venturi", "Dissout l'ozone dans l'eau"],
        ["Robinet sans contact", "Un capteur infrarouge le démarre et l'arrête"],
        ["Alimentation haute tension", "Alimente le plasma, boîtier relié à la terre"],
      ],
    };

// Callout anchors on the drawing, and where their labels sit.
const callouts = [
  { n: 1, ax: 335, ay: 452, side: "left", ly: 405 },
  { n: 2, ax: 330, ay: 330, side: "left", ly: 320 },
  { n: 3, ax: 310, ay: 243, side: "left", ly: 210 },
  { n: 4, ax: 528, ay: 330, side: "right", ly: 320 },
  { n: 5, ax: 515, ay: 110, side: "right", ly: 100 },
  { n: 6, ax: 470, ay: 452, side: "right", ly: 440 },
];
const bubbles = [
  [519, 300], [521, 275], [518, 250], [522, 225], [519, 200],
  [455, 108], [457, 120], [454, 132],
];
---

<figure class:list={["ozd", { compact }]}>
  <svg viewBox={compact ? "250 40 320 480" : "-80 30 960 500"} role="img" aria-label={L.title}>
    <defs>
      <marker id={`${id}-arr`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0 0L10 5L0 10z" class="arr-ink"></path>
      </marker>
      <marker id={`${id}-arr-w`} viewBox="0 0 10 10" refX="5" refY="5" markerWidth="16" markerHeight="16" markerUnits="userSpaceOnUse" orient="auto">
        <path d="M0 0L10 5L0 10z" class="arr-water"></path>
      </marker>
    </defs>

    <ellipse cx="410" cy="512" rx="170" ry="10" class="shadow"></ellipse>

    <!-- cabinet, front cut away -->
    <rect x="270" y="170" width="280" height="336" rx="8" class="cab"></rect>
    <rect x="284" y="184" width="252" height="308" rx="5" class="inside"></rect>
    <!-- worktop and basin -->
    <rect x="252" y="148" width="316" height="26" rx="6" class="top"></rect>
    <path d="M300 152 h170 l-12 20 h-146 z" class="basin"></path>

    <!-- air intake grille -->
    <g class="grille">
      <line x1="276" y1="440" x2="276" y2="462"></line>
      <line x1="280" y1="440" x2="280" y2="462"></line>
    </g>
    {!compact && <text x="226" y="488" class="tag">{L.air}</text>}
    <line x1="226" y1="466" x2="268" y2="456" class="flow-air" marker-end={`url(#${id}-arr)`}></line>

    <!-- air pump -->
    <rect x="300" y="430" width="72" height="44" rx="7" class="part"></rect>
    <circle cx="322" cy="452" r="9" class="part-detail"></circle>
    <path d="M336 330 V430" class="flow-air"></path>

    <!-- cold-plasma generator -->
    <rect x="300" y="310" width="196" height="40" rx="20" class="part"></rect>
    <rect x="316" y="318" width="164" height="24" rx="12" class="glow"></rect>
    <path d="M326 330 l8 -7 l8 14 l8 -14 l8 14 l8 -14 l8 14 l8 -14 l8 14 l8 -14 l8 14 l8 -14 l8 14 l8 -14 l8 14 l8 -14 l8 14 l8 -14 l8 7" class="spark"></path>

    <!-- high-voltage supply -->
    <rect x="410" y="430" width="78" height="44" rx="7" class="part"></rect>
    <path d="M452 437 l-10 16 h9 l-5 14 l14 -19 h-9 l5 -11 z" class="bolt"></path>
    <path d="M449 430 V350" class="wire-hv"></path>

    <!-- controller -->
    <rect x="296" y="222" width="104" height="42" rx="7" class="part ctrl"></rect>
    <path d="M308 236 h20 M308 244 h34 M308 252 h26" class="ctrl-lines"></path>
    <circle cx="384" cy="243" r="6" class="safety"></circle>
    <path d="M348 264 V310 M400 243 H512 M380 264 C380 380 470 360 470 430" class="signal"></path>

    <!-- water line: in, valve, venturi, up to the tap -->
    <path d="M640 478 H520 V176" class="water" marker-start={`url(#${id}-arr-w)`}></path>
    <rect x="510" y="402" width="20" height="26" rx="3" class="valve"></rect>
    {!compact && <text x="580" y="500" class="tag">{L.water}</text>}
    <path d="M509 312 L531 312 L524 330 L531 348 L509 348 L516 330 Z" class="venturi"></path>
    <path d="M496 330 H516" class="ozone"></path>
    {bubbles.map(([cx, cy]) => <circle cx={cx} cy={cy} r="2.6" class="o3" />)}

    <!-- tap with infrared sensor -->
    <path d="M520 150 V70 Q520 60 510 60 H466 Q456 60 456 70 V92" class="tap"></path>
    <circle cx="520" cy="110" r="5" class="ir"></circle>
    <path d="M515 112 L474 140 M515 112 L490 146" class="ir-beam"></path>
    <path d="M456 96 C455 112 457 128 455 146" class="stream"></path>

    {
      !compact &&
        callouts.map((c, i) => {
          const lx = c.side === "left" ? 236 : 600;
          return (
            <g>
              <path d={`M${c.ax} ${c.ay} L${c.side === "left" ? lx + 8 : lx - 8} ${c.ly + 2}`} class="leader" />
              <circle cx={c.ax} cy={c.ay} r="11" class="num-bg" />
              <text x={c.ax} y={c.ay + 4.5} class="num" text-anchor="middle">
                {c.n}
              </text>
              <text x={c.side === "left" ? lx : lx} y={c.ly} class="c-title" text-anchor={c.side === "left" ? "end" : "start"}>
                {L.items[i][0]}
              </text>
              <text x={lx} y={c.ly + 19} class="c-sub" text-anchor={c.side === "left" ? "end" : "start"}>
                {L.items[i][1]}
              </text>
            </g>
          );
        })
    }
  </svg>
</figure>

<style>
  .ozd {
    margin: 0;
    --water: #3b8fd4;
  }
  :global(:root[data-theme="dark"]) .ozd {
    --water: #6cb6f0;
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
    font-family: var(--f-body);
  }
  .shadow { fill: color-mix(in srgb, var(--ink) 10%, transparent); }
  .cab { fill: var(--surface); stroke: var(--ink); stroke-width: 2.5; }
  .inside { fill: var(--bg-alt); stroke: var(--rule); stroke-width: 1; }
  .top { fill: var(--surface); stroke: var(--ink); stroke-width: 2.5; }
  .basin { fill: color-mix(in srgb, var(--ink) 12%, var(--surface)); stroke: var(--ink); stroke-width: 1.5; }
  .grille line { stroke: var(--ink); stroke-width: 2; }
  .part { fill: var(--surface); stroke: var(--ink); stroke-width: 2; }
  .part-detail { fill: none; stroke: var(--ink); stroke-width: 1.5; }
  .glow { fill: color-mix(in srgb, var(--accent) 28%, transparent); }
  .spark { fill: none; stroke: var(--accent); stroke-width: 1.8; stroke-linejoin: round; }
  .bolt { fill: var(--accent); }
  .wire-hv { fill: none; stroke: var(--accent); stroke-width: 2.5; }
  .ctrl-lines { stroke: var(--muted); stroke-width: 2; stroke-linecap: round; }
  .safety { fill: var(--accent); }
  .signal { fill: none; stroke: var(--muted); stroke-width: 1.3; stroke-dasharray: 4 4; }
  .flow-air { fill: none; stroke: var(--ink); stroke-width: 2; stroke-dasharray: 2 5; stroke-linecap: round; }
  .water { fill: none; stroke: var(--water); stroke-width: 7; stroke-linejoin: round; stroke-linecap: round; }
  .valve { fill: var(--surface); stroke: var(--ink); stroke-width: 2; }
  .venturi { fill: var(--surface); stroke: var(--ink); stroke-width: 2; stroke-linejoin: round; }
  .ozone { stroke: var(--accent); stroke-width: 4; stroke-linecap: round; }
  .o3 { fill: var(--accent); }
  .tap { fill: none; stroke: var(--ink); stroke-width: 7; stroke-linecap: round; stroke-linejoin: round; }
  .ir { fill: var(--accent); }
  .ir-beam { stroke: var(--accent); stroke-width: 1.4; stroke-dasharray: 3 3; }
  .stream { fill: none; stroke: var(--water); stroke-width: 5; stroke-linecap: round; }
  .arr-ink { fill: var(--ink); }
  .arr-water { fill: var(--water); }
  .tag { font-size: 14px; font-weight: 600; fill: var(--muted); }
  .leader { fill: none; stroke: var(--muted); stroke-width: 1; }
  .num-bg { fill: var(--ink); }
  .num { font-size: 12px; font-weight: 700; fill: var(--bg); }
  .c-title { font-size: 15px; font-weight: 700; fill: var(--ink); }
  .c-sub { font-size: 13px; fill: var(--muted); }
  @media (max-width: 640px) {
    .ozd:not(.compact) {
      overflow-x: auto;
    }
    .ozd:not(.compact) svg {
      min-width: 640px;
    }
  }
</style>
