---
import "../styles/global.css";
import { getRelativeLocaleUrl } from "astro:i18n";
import { copy, languages, EMAIL, LINKEDIN, GITHUB, type Lang } from "../i18n/ui.ts";

interface Props {
  lang: Lang;
  /** Path inside the locale, e.g. "" for home or "work/scheduler". */
  path?: string;
  title?: string;
  description?: string;
}

const { lang, path = "", title, description } = Astro.props;
const t = copy[lang];
const other: Lang = lang === "en" ? "fr" : "en";
const home = getRelativeLocaleUrl(lang, "");
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
const canonical = new URL(getRelativeLocaleUrl(lang, path), Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {
      (Object.keys(languages) as Lang[]).map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(getRelativeLocaleUrl(l, path), Astro.site)} />
      ))
    }
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <script is:inline>
      // Apply the saved theme before the first paint. Light is the default.
      try {
        if (localStorage.getItem("theme") === "dark") document.documentElement.dataset.theme = "dark";
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{lang === "en" ? "Skip to content" : "Aller au contenu"}</a>
    <header class="top">
      <div class="wrap bar">
        <a class="name" href={home}>
          <span class="mark" aria-hidden="true">AB</span>
          <span>Adem Benlechheb</span>
        </a>
        <nav aria-label={lang === "en" ? "Main" : "Principal"}>
          <a class="nav-link" href={`${home}#work`}>{t.nav.work}</a>
          <a class="nav-link" href={`${home}#experience`}>{t.nav.experience}</a>
          <a class="nav-link" href={`${home}#hire`}>{t.nav.hire}</a>
          <a class="nav-link" href={`${home}#contact`}>{t.nav.contact}</a>
          <a class="chip" href={getRelativeLocaleUrl(other, path)} hreflang={other} lang={other}>
            {other.toUpperCase()}<span class="sr-only"> · {languages[other]}</span>
          </a>
          <button class="chip theme" type="button" data-theme-toggle aria-label={t.nav.theme}>
            <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
              ><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path
                d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"></path></svg
            >
            <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
              ><path
                d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linejoin="round"></path></svg
            >
          </button>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap foot-grid">
        <div>
          <p class="foot-name">Adem Benlechheb</p>
          <p>{t.footer.role}</p>
        </div>
        <div class="foot-links">
          <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
          <a href={LINKEDIN} rel="me noopener">LinkedIn</a>
          <a href={GITHUB} rel="me noopener">GitHub</a>
        </div>
        <p class="foot-note">© {new Date().getFullYear()} · {t.footer.demo}</p>
      </div>
    </footer>
    <script is:inline>
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const root = document.documentElement;
        const dark = root.dataset.theme !== "dark";
        if (dark) root.dataset.theme = "dark";
        else delete root.dataset.theme;
        try {
          localStorage.setItem("theme", dark ? "dark" : "light");
        } catch (e) {}
      });
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 16px;
    top: 12px;
    z-index: 20;
    background: var(--bg);
    padding: 8px 12px;
  }
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
  }
  .name {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: var(--ink);
    color: var(--bg);
    font-size: 13px;
    letter-spacing: 0.02em;
    position: relative;
  }
  .mark::after {
    content: "";
    position: absolute;
    right: -3px;
    bottom: -3px;
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--accent);
  }
  nav {
    display: flex;
    align-items: center;
    gap: clamp(10px, 2.4vw, 26px);
    font-size: 15px;
    font-weight: 500;
  }
  .nav-link {
    text-decoration: none;
    color: var(--muted);
  }
  .nav-link:hover {
    color: var(--ink);
  }
  .chip {
    display: inline-grid;
    place-items: center;
    min-width: 36px;
    height: 36px;
    padding: 0 8px;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }
  .chip:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  .theme .sun {
    display: none;
  }
  :global(:root[data-theme="dark"]) .theme .sun {
    display: block;
  }
  :global(:root[data-theme="dark"]) .theme .moon {
    display: none;
  }
  @media (max-width: 720px) {
    .nav-link {
      display: none;
    }
    .name span:last-child {
      font-size: 15px;
    }
  }
  .foot {
    border-top: 1px solid var(--rule);
    padding-block: 40px;
    font-size: 15px;
    color: var(--muted);
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 16px 32px;
    align-items: start;
  }
  .foot p {
    margin: 0;
  }
  .foot-name {
    color: var(--ink);
    font-weight: 700;
  }
  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
  }
  .foot-note {
    grid-column: 1 / -1;
    font-size: 13px;
  }
  @media (max-width: 640px) {
    .foot-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
