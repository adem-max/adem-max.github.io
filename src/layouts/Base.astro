---
import "../styles/global.css";
import { getRelativeLocaleUrl } from "astro:i18n";
import { copy, languages, EMAIL, LINKEDIN, GITHUB, type Lang } from "../i18n/ui.ts";

interface Props {
  lang: Lang;
  /** Path inside the locale, e.g. "" for home or "work/scheduler". */
  path?: string;
  title?: string;
  description?: string;
}

const { lang, path = "", title, description } = Astro.props;
const t = copy[lang];
const other: Lang = lang === "en" ? "fr" : "en";
const home = getRelativeLocaleUrl(lang, "");
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
const canonical = new URL(getRelativeLocaleUrl(lang, path), Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {
      (Object.keys(languages) as Lang[]).map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(getRelativeLocaleUrl(l, path), Astro.site)} />
      ))
    }
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <script is:inline>
      // Apply the saved theme before the first paint. Light is the default.
      try {
        if (localStorage.getItem("theme") === "dark") document.documentElement.dataset.theme = "dark";
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{lang === "en" ? "Skip to content" : "Aller au contenu"}</a>
    <header class="top" data-header>
      <div class="wrap bar">
        <a class="name" href={home}>
          <span class="mark" aria-hidden="true">AB</span>
          <span>Adem Benlechheb</span>
        </a>
        <nav aria-label={lang === "en" ? "Main" : "Principal"}>
          <div class="nav-links" id="nav-links">
            <a class="nav-link" href={`${home}#work`}>{t.nav.work}</a>
            <a class="nav-link" href={`${home}#experience`}>{t.nav.experience}</a>
            <a class="nav-link" href={`${home}#hire`}>{t.nav.hire}</a>
            <a class="nav-link" href="#contact">{t.nav.contact}</a>
          </div>
          <a class="chip" href={getRelativeLocaleUrl(other, path)} hreflang={other} lang={other}>
            {other.toUpperCase()}<span class="sr-only"> · {languages[other]}</span>
          </a>
          <button class="chip theme" type="button" data-theme-toggle aria-label={t.nav.theme}>
            <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
              ><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path
                d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"></path></svg
            >
            <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
              ><path
                d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linejoin="round"></path></svg
            >
          </button>
          <button class="chip menu" type="button" data-menu-toggle aria-controls="nav-links" aria-expanded="false" aria-label={t.nav.menu}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
              ><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg
            >
          </button>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <!-- The contact band closes every page, so a case study ends on the same call as the home page. -->
    <footer id="contact" class="foot" aria-labelledby="contact-title">
      <div class="wrap foot-main">
        <div>
          <h2 id="contact-title">{t.contact.heading}</h2>
          <p class="foot-lede">{t.contact.lede}</p>
          <p class="foot-email"><a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
        </div>
        <div class="foot-actions">
          <a class="btn primary" href={`mailto:${EMAIL}`}>{t.contact.email}</a>
          <a class="btn on-band" href={LINKEDIN} rel="me noopener">LinkedIn</a>
          <a class="btn on-band" href={GITHUB} rel="me noopener">GitHub</a>
        </div>
      </div>
      <div class="wrap">
        <div class="foot-base">
          <p><strong>Adem Benlechheb</strong> · {t.footer.role}</p>
          <p>© {new Date().getFullYear()} · {t.footer.demo}</p>
        </div>
      </div>
    </footer>
    <script is:inline>
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const root = document.documentElement;
        const dark = root.dataset.theme !== "dark";
        if (dark) root.dataset.theme = "dark";
        else delete root.dataset.theme;
        try {
          localStorage.setItem("theme", dark ? "dark" : "light");
        } catch (e) {}
      });
      // Small screens: the section links sit behind a menu button.
      (() => {
        const header = document.querySelector("[data-header]");
        const button = document.querySelector("[data-menu-toggle]");
        if (!header || !button) return;
        const set = (open) => {
          header.toggleAttribute("data-open", open);
          button.setAttribute("aria-expanded", String(open));
        };
        button.addEventListener("click", () => set(!header.hasAttribute("data-open")));
        header.querySelectorAll(".nav-link").forEach((a) => a.addEventListener("click", () => set(false)));
        document.addEventListener("keydown", (e) => e.key === "Escape" && set(false));
      })();
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 16px;
    top: 12px;
    z-index: 20;
    background: var(--bg);
    padding: 8px 12px;
  }
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
  }
  .name {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: var(--ink);
    color: var(--bg);
    font-size: 13px;
    letter-spacing: 0.02em;
    position: relative;
  }
  .mark::after {
    content: "";
    position: absolute;
    right: -3px;
    bottom: -3px;
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--accent);
  }
  nav {
    display: flex;
    align-items: center;
    gap: clamp(10px, 2.4vw, 26px);
    font-size: 15px;
    font-weight: 500;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(10px, 2.4vw, 26px);
  }
  .nav-link {
    text-decoration: none;
    color: var(--muted);
  }
  .nav-link:hover {
    color: var(--ink);
  }
  .chip {
    display: inline-grid;
    place-items: center;
    min-width: 36px;
    height: 36px;
    padding: 0 8px;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }
  .chip:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  .theme .sun {
    display: none;
  }
  :global(:root[data-theme="dark"]) .theme .sun {
    display: block;
  }
  :global(:root[data-theme="dark"]) .theme .moon {
    display: none;
  }
  .menu {
    display: none;
  }
  @media (max-width: 720px) {
    nav {
      gap: 8px;
    }
    .menu {
      display: inline-grid;
    }
    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 6px var(--gutter) 14px;
      background: var(--bg);
      border-bottom: 1px solid var(--rule);
      box-shadow: var(--shadow);
    }
    .top[data-open] .nav-links {
      display: flex;
    }
    .nav-link {
      padding: 12px 0;
      font-size: 17px;
      color: var(--ink);
      border-top: 1px solid var(--rule);
    }
    .nav-link:first-child {
      border-top: 0;
    }
    .name span:last-child {
      font-size: 15px;
    }
  }
  @media (max-width: 360px) {
    .bar {
      gap: 8px;
    }
    nav {
      gap: 6px;
    }
    .name {
      gap: 8px;
    }
    .name span:last-child {
      font-size: 14px;
    }
  }
  .foot {
    background: var(--band);
    color: var(--on-band);
    font-size: 15px;
  }
  .foot p {
    margin: 0;
  }
  .foot-main {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding-block: clamp(48px, 7vw, 80px);
  }
  .foot h2 {
    color: var(--on-band);
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: 700;
  }
  .foot-lede {
    margin-top: 10px !important;
    font-size: 17px;
    opacity: 0.85;
  }
  .foot-email {
    margin-top: 6px !important;
    font-size: 17px;
    font-weight: 600;
  }
  .foot a:not(.btn):hover {
    color: var(--accent);
  }
  .foot-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .btn.on-band {
    border-color: color-mix(in srgb, var(--on-band) 45%, transparent);
    color: var(--on-band);
  }
  .btn.on-band:hover {
    background: var(--on-band);
    color: var(--band);
  }
  .foot-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 24px;
    padding-block: 20px 28px;
    border-top: 1px solid color-mix(in srgb, var(--on-band) 16%, transparent);
    font-size: 13px;
    color: color-mix(in srgb, var(--on-band) 70%, transparent);
  }
  .foot-base strong {
    color: var(--on-band);
    font-weight: 600;
  }
</style>
